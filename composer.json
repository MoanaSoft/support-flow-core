{
    "name": "moanasoft/support-flow-core",
    "description": "Embeddable Laravel support qualification engine for the Moanasoft ecosystem.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Moanasoft",
            "email": "contact@moanasoft.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "moanasoft/foundation": "^0.4"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Moanasoft\\SupportFlowCore\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Moanasoft\\SupportFlowCore\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Moanasoft\\SupportFlowCore\\SupportFlowCoreServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "phpstan analyse",
        "format": "pint",
        "test": "phpunit"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
